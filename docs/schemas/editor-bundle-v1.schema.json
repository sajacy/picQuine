{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PicQuine editor bundle version 1",
  "description": "Passive update envelope. A supported consumer validates it before staging; the HTML payload is never executed during update checking.",
  "type": "object",
  "required": [
    "format",
    "version",
    "editor",
    "compatibility",
    "payload"
  ],
  "properties": {
    "format": {
      "const": "picquine-editor-bundle"
    },
    "version": {
      "const": 1
    },
    "editor": {
      "type": "object",
      "required": [
        "id",
        "version",
        "build",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "projectVersions",
        "extensions"
      ],
      "properties": {
        "projectVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "required": [
        "encoding",
        "sha256",
        "base64"
      ],
      "properties": {
        "encoding": {
          "const": "gzip+base64"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
